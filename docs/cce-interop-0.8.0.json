{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.2to8.cc/schemas/cce-interop-0.8.0.json",
  "type": "object",
  "title": "Cold Chain Equipment monitoring transmission",
  "description": "Schema for transmission of Cold-Chain Equipment (CCE) monitoring data from monitoring suppliers to third-parties (esp., countries). This schema supports both both EMS and non-EMS (i.e., RTM) data and is a derivative of the WHO/PQS EMS specification (esp., E006/DS01 and Annexes) to the greatest extent possible. Notable differences from the PQS EMS standards are (primarily) to accommodate RTM systems.",
  "additionalProperties": true,
  "required": [
    "meta",
    "data"
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/transmission-metadata"
    },
    "data": {
      "type": "array",
      "title": "Cold chain data reports",
      "description": "Array of data reports for one or more pieces of cold-chain equipment",
      "minItems": 1,
      "items": {
        "type": "object",
        "description": "Schema for individual CCE Report items is controlled by the value of 'meta.transferType' using the if/then/else conditional (see below)."
      }
    }
  },
  "if": {
    "properties": { "meta": { "properties": { "transferType": { "pattern": "^ems$" } } } }
  },
  "then": {
    "properties": { "data": { "items": { "$ref": "#/$defs/ems-report" } } }
  },
  "else": {
    "properties": { "data": { "items": { "$ref": "#/$defs/rtmd-report" } } }
  },
  "$defs": {
    "rtmd-record": {
      "type": "object",
      "title": "RTMD data record",
      "description": "Represents a data sample at a single point-in-time from an RTMD",
      "required": [
        "ABST",
        "ALRM",
        "BEMD",
        "EERR"
      ],
      "anyOf": [
        { "required": ["TVC"] },
        { "required": ["TFRZ"] },
        { "required": ["TAMB"] }
      ],
      "additionalProperties": true,
      "properties": {
        "ABST": { "$ref": "#/$defs/PQS-DS01-objects/ABST" },
        "ACCD": { "$ref": "#/$defs/PQS-DS01-objects/ACCD" },
        "ACSV": { "$ref": "#/$defs/PQS-DS01-objects/ACSV" },
        "ALRM": { "$ref": "#/$defs/PQS-DS01-objects/ALRM" },
        "BEMD": { "$ref": "#/$defs/PQS-DS01-objects/BEMD" },
        "BLOG": { "$ref": "#/$defs/PQS-DS01-objects/BLOG" },
        "CMPR": { "$ref": "#/$defs/PQS-DS01-objects/CMPR" },
        "CMPR2": { "$ref": "#/$defs/PQS-DS01-objects/CMPR2" },
        "CMPS": { "$ref": "#/$defs/PQS-DS01-objects/CMPS" },
        "CMPS2": { "$ref": "#/$defs/PQS-DS01-objects/CMPS2" },
        "CSOF": { "$ref": "#/$defs/PQS-DS01-objects/CSOF" },
        "CSOF2": { "$ref": "#/$defs/PQS-DS01-objects/CSOF2" },
        "DCCD": { "$ref": "#/$defs/PQS-DS01-objects/DCCD" },
        "DCSV": { "$ref": "#/$defs/PQS-DS01-objects/DCSV" },
        "DORF": { "$ref": "#/$defs/PQS-DS01-objects/DORF" },
        "DORV": { "$ref": "#/$defs/PQS-DS01-objects/DORV" },
        "DRCF": { "$ref": "#/$defs/PQS-DS01-objects/DRCF" },
        "DRCV": { "$ref": "#/$defs/PQS-DS01-objects/DRCV" },
        "EDOP": { "$ref": "#/$defs/PQS-DS01-objects/EDOP" },
        "EERR": { "$ref": "#/$defs/PQS-DS01-objects/EERR" },
        "EMSV": { "$ref": "#/$defs/PQS-DS01-objects/EMSV" },
        "FANS": { "$ref": "#/$defs/PQS-DS01-objects/FANS" },
        "HAMB": { "$ref": "#/$defs/PQS-DS01-objects/HAMB" },
        "HCOM": { "$ref": "#/$defs/PQS-DS01-objects/HCOM" },
        "HOLD": { "$ref": "#/$defs/PQS-DS01-objects/HOLD" },
        "IDRF": { "$ref": "#/$defs/PQS-DS01-objects/IDRF" },
        "IDRV": { "$ref": "#/$defs/PQS-DS01-objects/IDRV" },
        "LACC": { "$ref": "#/$defs/PQS-DS01-objects/LACC" },
        "LAT": { "$ref": "#/$defs/PQS-DS01-objects/LAT" },
        "LERR": { "$ref": "#/$defs/PQS-DS01-objects/LERR" },
        "LNG": { "$ref": "#/$defs/PQS-DS01-objects/LNG" },
        "LSV": { "$ref": "#/$defs/PQS-DS01-objects/LSV" },
        "MSW": { "$ref": "#/$defs/PQS-DS01-objects/MSW" },
        "SVA": { "$ref": "#/$defs/PQS-DS01-objects/SVA" },
        "TAMB": { "$ref": "#/$defs/PQS-DS01-objects/TAMB" },
        "TCON": { "$ref": "#/$defs/PQS-DS01-objects/TCON" },
        "TCON2": { "$ref": "#/$defs/PQS-DS01-objects/TCON2" },
        "TFRZ": { "$ref": "#/$defs/PQS-DS01-objects/TFRZ" },
        "TPCB": { "$ref": "#/$defs/PQS-DS01-objects/TPCB" },
        "TPCB2": { "$ref": "#/$defs/PQS-DS01-objects/TPCB2" },
        "TVC": { "$ref": "#/$defs/PQS-DS01-objects/TVC" }
      }
    },
    "rtmd-sensor-schema": {
      "type": "object",
      "title": "RTMD sensor definition",
      "description": "Describes a single sensor associated with an RTMD",
      "required": [
        "SID",
        "SMFR",
        "SMOD"
      ],
      "properties": {
        "SID": {
          "type": "string",
          "title": "Sensor ID",
          "description": "Unique sensor ID",
          "$comment": "This ID might be a serial number or another unique identifier (e.g., RTMD Serial Number + Sensor Port)"
        },
        "SMFR": {
          "type": "string",
          "title": "Sensor Manufacturer",
          "description": "Sensor Manufacturer"
        },
        "SMOD": {
          "type": "string",
          "title": "Sensor Model",
          "description": "Sensor Model"
        },
        "SDOP": {
          "type": "string",
          "title": "Sensor date of production",
          "description": "Sensor date of manufacture",
          "examples": [
            "2020-12-01"
          ]
        }
      },
      "additionalProperties": false
    },
    "rtmd-report": {
      "type": "object",
      "title": "RTMD data report",
      "description": "Report for a single RTMD, including metadata and a collection of rtmd-records",
      "required": [
        "AMID",
        "CID",
        "DLST",
        "EDOP",
        "EMFR",
        "EMOD",
        "EPQS",
        "ESER",
        "records"
      ],
      "additionalProperties": true,
      "properties": {
        "ACAT": { "$ref": "#/$defs/PQS-DS01-objects/ACAT" },
        "ADOP": { "$ref": "#/$defs/PQS-DS01-objects/ADOP" },
        "AID": { "$ref": "#/$defs/PQS-DS01-objects/AID" },
        "AMID": {
            "type": [
              "string"
            ],
            "title": "Appliance Monitoring ID",
            "description": "The ID of the appliance object in the RTMD supplier's cloud platform. Intended to provide a stable reference to the appliance in absence of other identifiers (e.g., serial number, asset number, etc.).",
            "examples": [
              "82b5d4f2-ba21-4d4e-b4d9-e693760c9e94",
              "tenant:0001964/facility:03/equipment:10"
            ]
        },
        "AMFR": { "$ref": "#/$defs/PQS-DS01-objects/AMFR" },
        "AMOD": { "$ref": "#/$defs/PQS-DS01-objects/AMOD" },
        "APQS": { "$ref": "#/$defs/PQS-DS01-objects/APQS" },
        "ASER": { "$ref": "#/$defs/PQS-DS01-objects/ASER" },
        "CDAT": { "$ref": "#/$defs/PQS-DS01-objects/CDAT" },
        "CDAT2": { "$ref": "#/$defs/PQS-DS01-objects/CDAT2" },
        "CID": { "$ref": "#/$defs/PQS-DS01-objects/CID" },
        "CNAM": { "$ref": "#/$defs/PQS-DS01-objects/CNAM" },
        "CNAM2": { "$ref": "#/$defs/PQS-DS01-objects/CNAM2" },
        "CSER": { "$ref": "#/$defs/PQS-DS01-objects/CSER" },
        "CSER2": { "$ref": "#/$defs/PQS-DS01-objects/CSER2" },
        "CSOF": { "$ref": "#/$defs/PQS-DS01-objects/CSOF" },
        "CSOF2": { "$ref": "#/$defs/PQS-DS01-objects/CSOF2" },
        "DNAM": { "$ref": "#/$defs/PQS-DS01-objects/DNAM" },
        "EDOP": { "$ref": "#/$defs/PQS-DS01-objects/EDOP" },
        "EID": { "$ref": "#/$defs/PQS-DS01-objects/EID" },
        "EMFR": { "$ref": "#/$defs/PQS-DS01-objects/EMFR" },
        "EMOD": { "$ref": "#/$defs/PQS-DS01-objects/EMOD" },
        "EMSV": { "$ref": "#/$defs/PQS-DS01-objects/EMSV" },
        "EPQS": { "$ref": "#/$defs/PQS-DS01-objects/EPQS" },
        "ESER": { "$ref": "#/$defs/PQS-DS01-objects/ESER" },
        "FID": { "$ref": "#/$defs/PQS-DS01-objects/FID" },
        "FNAM": { "$ref": "#/$defs/PQS-DS01-objects/FNAM" },
        "LACC": { "$ref": "#/$defs/PQS-DS01-objects/LACC" },
        "LAT": { "$ref": "#/$defs/PQS-DS01-objects/LAT" },
        "LDOP": { "$ref": "#/$defs/PQS-DS01-objects/LDOP" },
        "LID": { "$ref": "#/$defs/PQS-DS01-objects/LID" },
        "LMFR": { "$ref": "#/$defs/PQS-DS01-objects/LMFR" },
        "LMOD": { "$ref": "#/$defs/PQS-DS01-objects/LMOD" },
        "LNG": { "$ref": "#/$defs/PQS-DS01-objects/LNG" },
        "LPQS": { "$ref": "#/$defs/PQS-DS01-objects/LPQS" },
        "LSER": { "$ref": "#/$defs/PQS-DS01-objects/LSER" },
        "LSV": { "$ref": "#/$defs/PQS-DS01-objects/LSV" },
        "RNAM": { "$ref": "#/$defs/PQS-DS01-objects/RNAM" },
        "SIGN": { "$ref": "#/$defs/PQS-DS01-objects/SIGN" },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rtmd-record" }
        },
        "DLST": {
          "type": "object",
          "title": "RTMD device list",
          "description": "Maps fridge performance properties (e.g., TVC, TFRZ, etc.) to RTMD sensor definitions",
          "minProperties": 1,
          "propertyNames": {
            "enum": ["TVC", "TFRZ", "TAMB", "IDRV"]
          },
          "required": ["TVC"],
          "additionalProperties": {
            "$ref": "#/$defs/rtmd-sensor-schema"
          }
        }
      },
      "allOf": [
        {
            "oneOf": [
                {
                  "$comment": "EMSV is a member of the main object",
                  "required": [ "EMSV" ]
                },
                {
                  "$comment": "EMSV is a member each object within the records array",
                  "properties": {
                        "records": {
                            "items": { "required": [ "EMSV" ] }
                        }
                    }
                }
            ]
        }
      ]
    },
    "ems-record": {
      "type": "object",
      "title": "EMS data record",
      "description": "Represents a data sample at a single point-in-time from an EMS device",
      "required": [
        "ABST",
        "ALRM",
        "BEMD",
        "BLOG",
        "CMPR",
        "DORV",
        "EERR",
        "LERR",
        "TAMB"
      ],
      "additionalProperties": true,
      "properties": {
        "ABST": { "$ref": "#/$defs/PQS-DS01-objects/ABST" },
        "ACCD": { "$ref": "#/$defs/PQS-DS01-objects/ACCD" },
        "ACSV": { "$ref": "#/$defs/PQS-DS01-objects/ACSV" },
        "ALRM": { "$ref": "#/$defs/PQS-DS01-objects/ALRM" },
        "BEMD": { "$ref": "#/$defs/PQS-DS01-objects/BEMD" },
        "BLOG": { "$ref": "#/$defs/PQS-DS01-objects/BLOG" },
        "CMPR": { "$ref": "#/$defs/PQS-DS01-objects/CMPR" },
        "CMPR2": { "$ref": "#/$defs/PQS-DS01-objects/CMPR2" },
        "CMPS": { "$ref": "#/$defs/PQS-DS01-objects/CMPS" },
        "CMPS2": { "$ref": "#/$defs/PQS-DS01-objects/CMPS2" },
        "CSOF": { "$ref": "#/$defs/PQS-DS01-objects/CSOF" },
        "CSOF2": { "$ref": "#/$defs/PQS-DS01-objects/CSOF2" },
        "DCCD": { "$ref": "#/$defs/PQS-DS01-objects/DCCD" },
        "DCSV": { "$ref": "#/$defs/PQS-DS01-objects/DCSV" },
        "DORF": { "$ref": "#/$defs/PQS-DS01-objects/DORF" },
        "DORV": { "$ref": "#/$defs/PQS-DS01-objects/DORV" },
        "DRCF": { "$ref": "#/$defs/PQS-DS01-objects/DRCF" },
        "DRCV": { "$ref": "#/$defs/PQS-DS01-objects/DRCV" },
        "EDOP": { "$ref": "#/$defs/PQS-DS01-objects/EDOP" },
        "EERR": { "$ref": "#/$defs/PQS-DS01-objects/EERR" },
        "EMSV": { "$ref": "#/$defs/PQS-DS01-objects/EMSV" },
        "FANS": { "$ref": "#/$defs/PQS-DS01-objects/FANS" },
        "HAMB": { "$ref": "#/$defs/PQS-DS01-objects/HAMB" },
        "HCOM": { "$ref": "#/$defs/PQS-DS01-objects/HCOM" },
        "HOLD": { "$ref": "#/$defs/PQS-DS01-objects/HOLD" },
        "IDRF": { "$ref": "#/$defs/PQS-DS01-objects/IDRF" },
        "IDRV": { "$ref": "#/$defs/PQS-DS01-objects/IDRV" },
        "LACC": { "$ref": "#/$defs/PQS-DS01-objects/LACC" },
        "LAT": { "$ref": "#/$defs/PQS-DS01-objects/LAT" },
        "LERR": { "$ref": "#/$defs/PQS-DS01-objects/LERR" },
        "LNG": { "$ref": "#/$defs/PQS-DS01-objects/LNG" },
        "LSV": { "$ref": "#/$defs/PQS-DS01-objects/LSV" },
        "MSW": { "$ref": "#/$defs/PQS-DS01-objects/MSW" },
        "SVA": { "$ref": "#/$defs/PQS-DS01-objects/SVA" },
        "TAMB": { "$ref": "#/$defs/PQS-DS01-objects/TAMB" },
        "TCON": { "$ref": "#/$defs/PQS-DS01-objects/TCON" },
        "TCON2": { "$ref": "#/$defs/PQS-DS01-objects/TCON2" },
        "TFRZ": { "$ref": "#/$defs/PQS-DS01-objects/TFRZ" },
        "TPCB": { "$ref": "#/$defs/PQS-DS01-objects/TPCB" },
        "TPCB2": { "$ref": "#/$defs/PQS-DS01-objects/TPCB2" },
        "TVC": { "$ref": "#/$defs/PQS-DS01-objects/TVC" }
      },
      "allOf": [
        {
            "oneOf": [
                {
                  "$comment": "For mains appliances, SVA is included in the record",
                  "required": [ "SVA" ],
                  "not": { "required": [ "DCSV", "DCCD" ] }
                },
                {
                  "$comment": "For solar appliances, DCSV and DCCD are included in the record",
                  "required": [ "DCSV", "DCCD" ],
                  "not": { "required": [ "SVA" ] }
                }
            ]
        },
        {
            "oneOf": [
                {
                  "$comment": "NORMAL CASE: TVC is provided in numeric format, consistent with the EMS data specification",
                  "required": ["TVC"],
                  "properties": {
                    "TVC": {
                      "type": "number"
                    }
                  }
                },
                {
                  "$comment": "ABNORMAL CASE: TVC is null but LERR is non-null, reflecting an error with the TVC sensor",
                  "required": ["TVC", "LERR"],
                  "properties": {
                    "LERR": {
                      "type": "string",
                      "minLength": 1
                    },
                    "TVC": {
                      "type": "null"
                    }
                  }
                }
            ]
        }
      ]
    },
    "ems-report": {
      "type": "object",
      "title": "EMS data report",
      "description": "Report for a single EMS device, including metadata and a collection of ems-records",
      "required": [
        "CID",
        "ADOP",
        "AMFR",
        "AMOD",
        "APQS",
        "ASER",
        "LDOP",
        "LMFR",
        "LMOD",
        "LPQS",
        "LSER",
        "EDOP",
        "EMFR",
        "EMOD",
        "EPQS",
        "ESER",
        "records"
      ],
      "additionalProperties": true,
      "properties": {
        "ACAT": { "$ref": "#/$defs/PQS-DS01-objects/ACAT" },
        "ADOP": { "$ref": "#/$defs/PQS-DS01-objects/ADOP" },
        "AID": { "$ref": "#/$defs/PQS-DS01-objects/AID" },
        "AMFR": { "$ref": "#/$defs/PQS-DS01-objects/AMFR" },
        "AMOD": { "$ref": "#/$defs/PQS-DS01-objects/AMOD" },
        "APQS": { "$ref": "#/$defs/PQS-DS01-objects/APQS" },
        "ASER": { "$ref": "#/$defs/PQS-DS01-objects/ASER" },
        "CDAT": { "$ref": "#/$defs/PQS-DS01-objects/CDAT" },
        "CDAT2": { "$ref": "#/$defs/PQS-DS01-objects/CDAT2" },
        "CID": { "$ref": "#/$defs/PQS-DS01-objects/CID" },
        "CNAM": { "$ref": "#/$defs/PQS-DS01-objects/CNAM" },
        "CNAM2": { "$ref": "#/$defs/PQS-DS01-objects/CNAM2" },
        "CSER": { "$ref": "#/$defs/PQS-DS01-objects/CSER" },
        "CSER2": { "$ref": "#/$defs/PQS-DS01-objects/CSER2" },
        "CSOF": { "$ref": "#/$defs/PQS-DS01-objects/CSOF" },
        "CSOF2": { "$ref": "#/$defs/PQS-DS01-objects/CSOF2" },
        "DNAM": { "$ref": "#/$defs/PQS-DS01-objects/DNAM" },
        "EDOP": { "$ref": "#/$defs/PQS-DS01-objects/EDOP" },
        "EID": { "$ref": "#/$defs/PQS-DS01-objects/EID" },
        "EMFR": { "$ref": "#/$defs/PQS-DS01-objects/EMFR" },
        "EMOD": { "$ref": "#/$defs/PQS-DS01-objects/EMOD" },
        "EMSV": { "$ref": "#/$defs/PQS-DS01-objects/EMSV" },
        "EPQS": { "$ref": "#/$defs/PQS-DS01-objects/EPQS" },
        "ESER": { "$ref": "#/$defs/PQS-DS01-objects/ESER" },
        "FID": { "$ref": "#/$defs/PQS-DS01-objects/FID" },
        "FNAM": { "$ref": "#/$defs/PQS-DS01-objects/FNAM" },
        "LACC": { "$ref": "#/$defs/PQS-DS01-objects/LACC" },
        "LAT": { "$ref": "#/$defs/PQS-DS01-objects/LAT" },
        "LDOP": { "$ref": "#/$defs/PQS-DS01-objects/LDOP" },
        "LID": { "$ref": "#/$defs/PQS-DS01-objects/LID" },
        "LMFR": { "$ref": "#/$defs/PQS-DS01-objects/LMFR" },
        "LMOD": { "$ref": "#/$defs/PQS-DS01-objects/LMOD" },
        "LNG": { "$ref": "#/$defs/PQS-DS01-objects/LNG" },
        "LPQS": { "$ref": "#/$defs/PQS-DS01-objects/LPQS" },
        "LSER": { "$ref": "#/$defs/PQS-DS01-objects/LSER" },
        "LSV": { "$ref": "#/$defs/PQS-DS01-objects/LSV" },
        "RNAM": { "$ref": "#/$defs/PQS-DS01-objects/RNAM" },
        "SIGN": { "$ref": "#/$defs/PQS-DS01-objects/SIGN" },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ems-record" }
        }
      },
      "allOf": [
        {
            "oneOf": [
                {
                  "$comment": "LSV is a member of the main object",
                  "required": [ "LSV" ]
                },
                {
                  "$comment": "LSV is a member each object within the records array",
                  "properties": {
                        "records": {
                            "items": { "required": [ "LSV" ] }
                        }
                    }
                }
            ]
        },
        {
          "oneOf": [
              {
                "$comment": "EMSV is a member of the main object",
                "required": [ "EMSV" ]
              },
              {
                "$comment": "EMSV is a member each object within the records array",
                "properties": {
                      "records": {
                          "items": { "required": [ "EMSV" ] }
                      }
                  }
              }
          ]
        }
      ]
    },
    "transmission-metadata": {
      "type": "object",
      "title": "Transmission metadata",
      "description": "Metadata about the data transmission / transfer",
      "additionalProperties": true,
      "required": [
        "schemaVersion",
        "transferType",
        "transferId",
        "transferSrc",
        "transferredAt"
      ],
      "properties": {
        "schemaVersion": {
          "type": [
            "string"
          ],
          "title": "Transmission schema version",
          "description": "Version of the JSON schema against which the transmission should be validated (see the $id field at the top of this document)",
          "examples": [
            "0.1.1"
          ]
        },
        "transferType": {
          "type": [
            "string"
          ],
          "title": "Data transmission type",
          "description": "Type of data transmission (e.g., RTM, EMS, etc.)",
          "enum": [ "rtm", "ems" ],
          "examples": [
            "rtm"
          ]
        },
        "transferId": {
          "type": [
            "string"
          ],
          "title": "Data transmission identifier",
          "description": "Unique ID of a specific data transmission (generated by supplier)",
          "examples": [
            "be02ecfb-2f4f-4139-a2fa-508105740eee",
            "KE:SER19239898179:1701989567:1701903170"
          ]
        },
        "transferSrc": {
          "type": [
            "string"
          ],
          "title": "Data transmission source",
          "description": "URI of the data transmission source",
          "examples": [
            "com.mycompany",
            "https://mycompany.com"
          ]
        },
        "transferredAt": {
          "type": [
            "string"
          ],
          "title": "Data transmission datetime",
          "description": "Datetime of data tansmission",
          "pattern": "^2[0-9]{3}-[01][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$",
          "examples": [
            "2023-08-12T13:07:21Z"
          ]
        },
        "transferCallbackUrl": {
          "type": [
            "string"
          ],
          "title": "Webhook callback URL",
          "description": "URL of webhook to be called with data processing status",
          "examples": [
            "https://mycompany.com/rtm-webhook"
          ]
        }
      }
    },
    "PQS-DS01-objects": {
      "ABST": {
        "type": "string",
        "title": "Absolute time in UTC",
        "description": "Absolute time measured in UTC",
        "pattern": "^2[0-9]{7}T[0-2][0-9]{5}(\\.[0-9]+)?Z$",
        "examples": [
          "20200115T040554Z"
        ]
      },
      "ACAT": {
        "type": [
          "string",
          "null"
        ],
        "title": "Appliance PQS device type",
        "description": "PQS device type or category",
        "examples": [
          "RF03"
        ]
