# CCE Data Delivery Validator — example environment
#
# Copy to `.env` (gitignored) and edit. Every variable is optional: the service
# boots on its defaults. The authoritative table — what each one does, where it
# is read, and how it fails — is docs/deployment.md §4 ("Environment variable
# surface"). This file is the copy-paste starting point, not a second copy of
# that table.
#
# WHO READS WHAT — this matters, because `.env` is not a single switch:
#
#   * `docker compose` reads this file automatically, but only to interpolate
#     `${...}` in docker-compose.yml. That means the COMPOSE-LEVEL block below
#     plus TRUSTED_PROXY and RETENTION_SWEEP_MS take effect; the app's
#     PORT/HOST/DATABASE_URL/PG* are set by docker-compose.yml itself (derived
#     from POSTGRES_*), so editing them here changes nothing under compose.
#     Change the POSTGRES_* values and the app's connection string follows.
#
#   * The app does NOT load `.env` — there is no dotenv dependency. Running it
#     outside compose (`npm run dev`, `node dist/index.js`, a systemd unit), the
#     APP-LEVEL block is what your shell or process manager must export.
#
# ─────────────────────────────────────────────────────────────────────────────
# MUST CHANGE BEFORE ANY PUBLIC DEPLOYMENT
#
#   POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
#       The `cce_validator` trio below is a published default — it sits in this
#       file, in docker-compose.yml, and in the docs. Treat it as a known
#       credential pair: fine on a laptop, unacceptable on anything reachable.
#
#   POSTGRES_PORT / APP_PORT
#       Both publish to the host. In production Postgres should not be
#       published at all, and the app port must not be publicly reachable
#       (DESIGN §4.1) — bind it to loopback or drop the mapping and reach the
#       app only through the `edge` (Caddy) profile.
#
#   TRUSTED_PROXY
#       The loopback default trusts nobody but ourselves. Behind the `edge`
#       profile the proxy is a *container*, so this must name its address or
#       subnet, or X-Forwarded-Proto is ignored and §1.2 grading goes wrong.
#       Never set it to a blanket `true`. See docs/deployment.md §3.
# ─────────────────────────────────────────────────────────────────────────────


# =============================================================================
# COMPOSE-LEVEL — read by docker-compose.yml, never by the app
# =============================================================================
# These configure the `postgres` container and the host port mappings. Compose
# interpolates them into the app service's DATABASE_URL and PG* environment,
# so changing the credentials here is what changes the app's connection.

# Database name and credentials for the postgres container. Dev defaults — see
# the MUST CHANGE callout above.
POSTGRES_DB=cce_validator
POSTGRES_USER=cce_validator
POSTGRES_PASSWORD=cce_validator

# Host port Postgres is published on. Development convenience so `npm test` and
# psql can reach it; do not publish it in production.
POSTGRES_PORT=5432

# Host port the app is published on. Development convenience; in production
# bind to loopback or remove the mapping (DESIGN §4.1).
APP_PORT=3000

# Whose X-Forwarded-* headers Fastify believes (src/app.ts). The one app-level
# setting compose does pass through from here, which is why it appears in this
# block. A correctness setting, not a preference — see the callout above.
TRUSTED_PROXY=127.0.0.1


# =============================================================================
# APP-LEVEL — read by the Node process, for running it OUTSIDE compose
# =============================================================================
# Under compose these are supplied by docker-compose.yml and the values here are
# inert — with one exception, RETENTION_SWEEP_MS at the end of the block, which
# compose interpolates from here the way it does TRUSTED_PROXY. Export the rest
# yourself when running the app directly.

# Listen port (src/index.ts).
PORT=3000

# Listen address (src/index.ts). 0.0.0.0 is correct *inside* a container; what
# must be restricted is the container's publication, not this value.
HOST=0.0.0.0

# Postgres connection, preferred whenever set and handed to `pg` verbatim
# (src/db/pool.ts). Below is the compose-local form as seen from the HOST —
# what `npm run dev` and the DB-gated tests want against `docker compose up -d
# postgres`. Inside the compose network the host is the service name instead
# (`@postgres:5432`), which is the form docker-compose.yml builds for itself.
DATABASE_URL=postgresql://cce_validator:cce_validator@localhost:5432/cce_validator

# Split fallback, used by `pg` ONLY when DATABASE_URL is unset. Leave commented
# unless you are deliberately using this form instead.
#PGHOST=localhost
#PGPORT=5432
#PGDATABASE=cce_validator
#PGUSER=cce_validator
#PGPASSWORD=cce_validator

# Cadence of the retention sweep in milliseconds (src/index.ts), default 1 h.
# Cadence only: it changes how promptly expired sessions are reaped, never what
# is reaped. The 7-day window itself is not env-tunable.
#
# The one app-level setting in this block that compose DOES pass through from
# here: docker-compose.yml interpolates it into the app service's environment
# (bug 4w4). Change it and `docker compose up -d` picks it up.
RETENTION_SWEEP_MS=3600000
