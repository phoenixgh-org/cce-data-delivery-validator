{
  "name": "cce-data-delivery-validator",
  "version": "0.1.0",
  "description": "Receiving-side conformance validator for WHO PQS E006/DS01 CCE data delivery — plays the employer system and gives suppliers an independent read on their conformance",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phoenixgh-org/cce-data-delivery-validator.git"
  },
  "homepage": "https://github.com/phoenixgh-org/cce-data-delivery-validator#readme",
  "bugs": {
    "url": "https://github.com/phoenixgh-org/cce-data-delivery-validator/issues"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-schemas.mjs && npm run typecheck:web && vite build",
    "build:web": "npm run typecheck:web && vite build",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:db": "DATABASE_URL=postgresql://cce_validator:cce_validator@localhost:5432/cce_validator npm test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@tanstack/react-virtual": "^3.14.3",
    "ajv": "^8.20.0",
    "fastify": "^5.8.5",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  }
}
